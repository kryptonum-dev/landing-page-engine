---
import sanityFetch from '@/utils/sanity.fetch'
import { DOMAIN } from '../global/constants'

type Props = {
  slug?: string
}

const { slug } = Astro.props

const { gtmId, pageData } = await sanityFetch<{
  gtmId: string | null
  pageData: {
    name: string
    id: string
    description: string
    url: string
    title: string
    type: string
    createdAt: string
    updatedAt: string
    author: string
    template: string
    isPublished: boolean
    tags: string[]
    primaryCTA: string
    locale: string
    marketingCampaign?: string
    seoScore?: number
  }
}>({
  query: `*[_type == "page" && slug.current == $slug][0]{
    "gtmId": analytics.gtmId,
    "pageData": {
      "name": name,
      "id": _id,
      "description": seo.description,
      "url": slug.current,
      "title": seo.title,
      "type": _type,
      "createdAt": _createdAt,
      "updatedAt": _updatedAt,
      "author": author.name,
      "template": template,
      "isPublished": isPublished,
      "tags": tags,
      "primaryCTA": primaryCTA,
      "locale": locale,
      "marketingCampaign": marketingCampaign,
      "seoScore": seoScore
    }
  }`,
  params: { slug },
})

const fullUrl = `https://${DOMAIN}/${pageData?.url}`

const now = new Date()
const hours = now.getHours()
const minutes = now.getMinutes()
const eventHour = `${hours.toString().padStart(2, '0')}-${minutes.toString().padStart(2, '0')}`
const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
const months = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
]
const eventDay = days[now.getDay()]
const eventMonth = months[now.getMonth()]

const commonData = {
  user_role: 'guest',
  traffic_source: 'direct',
  event_hour: eventHour,
  event_day: eventDay,
  event_month: eventMonth,
  page_url: fullUrl,
  page_title: pageData.title,
  page_type: 'landing_page',
  time_on_site: 0,
  scroll_depth: 0,
}

const viewContentData = {
  ...commonData,
  content_name: pageData.title,
  content_category: 'Bez kategorii',
  content_id: pageData.id,
  content_type: pageData.type,
  content_description: pageData.description,
  content_language: 'pl',
}
---

{
  !!gtmId && (
    <script
      is:inline
      set:html={`
          window.dataLayer = window.dataLayer || [];

          (function(w,d,s,l,i){
            w[l]=w[l]||[];
            w[l].push({
              'gtm.start': new Date().getTime(),
              event: 'gtm.js'
            });
            var f=d.getElementsByTagName(s)[0];
            if(f&&f.parentNode){
              var j=d.createElement(s);
              j.async=true;
              j.src='https://www.googletagmanager.com/gtm.js?id='+i+(l!='dataLayer'?'&l='+l:'');
              f.parentNode.insertBefore(j,f);
            }
          })(window,document,'script','dataLayer','${gtmId}');

          window.dataLayer.push({
            event: 'page_view',
            ...${JSON.stringify(commonData)},
            page_referrer: document.referrer,
            language: navigator.language,
            viewport_width: window.innerWidth,
            viewport_height: window.innerHeight,
            screen_resolution: window.screen.width + 'x' + window.screen.height,
            user_agent: navigator.userAgent
          });

          window.dataLayer.push({
            event: 'view_content',
            ...${JSON.stringify(viewContentData)}
          });
        `}
    />
  )
}
