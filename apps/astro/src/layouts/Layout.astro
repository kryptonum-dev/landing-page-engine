---
import '@/global/global.scss'
import { LOCALE } from '@/global/constants'
import Head, { type Props as HeadProps } from './Head.astro'
import OrganizationSchema from '@/schema/OrganizationSchema.astro'
import FaqPageSchema from '@/schema/FaqPageSchema.astro'
import GoogleTagManager from '@/components/GoogleTagManager.astro'

type LayoutProps = HeadProps & {
  slug?: string
}

const { slug, ...props } = Astro.props as LayoutProps
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <Head {...props} />
    <OrganizationSchema />
    <FaqPageSchema />
    <slot name="head" />
  </head>
  <body>
    <GoogleTagManager slug={slug} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
